{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/main/nicegui/static/tauri.v2.schema.json",
  "productName": "BorgDock",
  "version": "1.2.0",
  "identifier": "com.borgdock.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "BorgDock",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "shadow": true,
        "center": true,
        "skipTaskbar": false,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://api.github.com https://*.visualstudio.com https://dev.azure.com; img-src 'self' https://avatars.githubusercontent.com data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/borght-dev/BorgDock/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2MkU2NEIwMEQwODExOEIKUldTTEVRZ05zR1F1dHJlWnhTWHduQzRnVGZ6MWFxVXdqbEtraENkdFYyK0JuYUlLZ01LQXFra0sK"
    }
  }
}
