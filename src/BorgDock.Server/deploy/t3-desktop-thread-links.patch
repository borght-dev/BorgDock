@@ -0,0 +1,32 @@
+import { describe, expect, it } from "vite-plus/test";
+import { desktopThreadUrl, parseDesktopThreadLink } from "./DesktopThreadLink.ts";
+
+const environmentId = "0f1e2d3c-4b5a-4697-8877-665544332211";
+const threadId = "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d";
+
+describe("desktop thread links", () => {
+  it.each([false, true])("routes the exact environment and thread, dev=%s", (dev) => {
+    const scheme = dev ? "t3code-dev" : "t3code";
+    const link = parseDesktopThreadLink(`${scheme}://threads/${environmentId}/${threadId}`, dev);
+    expect(link).toEqual({ environmentId, threadId });
+    expect(desktopThreadUrl(link!, dev)).toBe(`${scheme}://app/#/${environmentId}/${threadId}`);
+  });
+
+  it.each([
+    undefined,
+    "",
+    "invalid",
+    "http://threads/env/thread",
+    "t3code-dev://threads/env/thread",
+    "t3code://app/env/thread",
+    "t3code://threads:123/env/thread",
+    "t3code://user@threads/env/thread",
+    "t3code://threads/env/thread?prompt=run",
+    "t3code://threads/env/thread#anything",
+    "t3code://threads/env",
+    "t3code://threads/env/thread/extra",
+    "t3code://threads/env/%2F",
+  ])("ignores unsupported link %s", (url) => {
+    expect(parseDesktopThreadLink(url, false)).toBeUndefined();
+  });
+});
diff --git a/apps/desktop/src/app/DesktopThreadLink.ts b/apps/desktop/src/app/DesktopThreadLink.ts
new file mode 100644
index 00000000..080c2e36
--- /dev/null
+++ b/apps/desktop/src/app/DesktopThreadLink.ts
@@ -0,0 +1,34 @@
+export type DesktopThreadLink = {
+  readonly environmentId: string;
+  readonly threadId: string;
+};
+
+export function parseDesktopThreadLink(
+  value: string | undefined,
+  isDevelopment: boolean,
+): DesktopThreadLink | undefined {
+  if (!value) return undefined;
+  try {
+    const url = new URL(value);
+    const protocol = isDevelopment ? "t3code-dev:" : "t3code:";
+    if (
+      url.protocol !== protocol ||
+      url.host !== "threads" ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    )
+      return undefined;
+    const match = /^\/([\w-]+)\/([\w-]+)$/.exec(url.pathname);
+    if (!match?.[1] || !match[2]) return undefined;
+    return { environmentId: match[1], threadId: match[2] };
+  } catch {
+    return undefined;
+  }
+}
+
+export function desktopThreadUrl(link: DesktopThreadLink, isDevelopment: boolean): string {
+  const scheme = isDevelopment ? "t3code-dev" : "t3code";
+  return `${scheme}://app/#/${encodeURIComponent(link.environmentId)}/${encodeURIComponent(link.threadId)}`;
+}
