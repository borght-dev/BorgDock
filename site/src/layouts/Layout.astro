---
import '~/styles/tokens.css';
import '~/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'BorgDock keeps every pull request in one window: it watches your checks, tells you what needs you, hands failures to Claude, and lets you review and merge without a browser tab.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />

    {/* Theme before first paint: the saved choice wins, otherwise the system
        preference, which is then followed live. */}
    <script is:inline>
      (function () {
        try {
          var mql = window.matchMedia('(prefers-color-scheme: dark)');
          var apply = function () {
            var saved = localStorage.getItem('prdock-theme');
            var isDark = saved === 'dark' || (saved !== 'light' && mql.matches);
            document.documentElement.classList.toggle('dark', isDark);
          };
          apply();
          if (mql.addEventListener) {
            mql.addEventListener('change', function () {
              var s = localStorage.getItem('prdock-theme');
              if (s !== 'light' && s !== 'dark') apply();
            });
          }
        } catch (e) {}
      })();
    </script>

    {/* Platform on <html data-os>, read by the download buttons and page. */}
    <script is:inline>
      (function () {
        try {
          var ua = navigator.userAgent || '';
          var p = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '').toLowerCase();
          var os = /win/.test(p) || /windows/i.test(ua) ? 'win'
            : /mac|iphone|ipad/.test(p) || /mac os/i.test(ua) ? 'mac'
            : /linux|x11|cros/.test(p) || /linux/i.test(ua) ? 'linux' : 'win';
          document.documentElement.dataset.os = os;
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
