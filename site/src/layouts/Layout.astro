---
import '~/styles/tokens.css';
import '~/styles/global.css';
import { OS_NAME, REPO_URL, installers, latestRelease } from '~/data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'BorgDock is a free desktop app for GitHub pull requests and Azure DevOps work items. Monitor CI checks, review code and merge PRs in one window.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
canonical.search = '';
canonical.hash = '';
const image = new URL('/screens/focus-board-dark@2x.png', Astro.site);
const home = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#website`, name: 'BorgDock', url: home, inLanguage: 'en' },
    {
      '@type': 'SoftwareApplication', '@id': `${home}#app`, name: 'BorgDock', url: home,
      description, applicationCategory: 'DeveloperApplication',
      operatingSystem: [...new Set(installers.map((installer) => OS_NAME[installer.os]))].join(', '),
      softwareVersion: latestRelease.version, downloadUrl: new URL('/download/', Astro.site).href,
      isAccessibleForFree: true, license: `${REPO_URL}/blob/master/LICENSE`, sameAs: [REPO_URL],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BorgDock" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:alt" content="BorgDock Focus board showing GitHub pull requests by status" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    {Astro.url.pathname === '/' && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Theme before first paint: the saved choice wins, otherwise the system
        preference, which is then followed live. */}
    <script is:inline>
      (function () {
        try {
          var mql = window.matchMedia('(prefers-color-scheme: dark)');
          var apply = function () {
            var saved = localStorage.getItem('prdock-theme');
            var isDark = saved === 'dark' || (saved !== 'light' && mql.matches);
            document.documentElement.classList.toggle('dark', isDark);
          };
          apply();
          if (mql.addEventListener) {
            mql.addEventListener('change', function () {
              var s = localStorage.getItem('prdock-theme');
              if (s !== 'light' && s !== 'dark') apply();
            });
          }
        } catch (e) {}
      })();
    </script>

    {/* Platform on <html data-os>, read by the download buttons and page. */}
    <script is:inline>
      (function () {
        try {
          var ua = navigator.userAgent || '';
          var p = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '').toLowerCase();
          var os = /win/.test(p) || /windows/i.test(ua) ? 'win'
            : /mac|iphone|ipad/.test(p) || /mac os/i.test(ua) ? 'mac'
            : /linux|x11|cros/.test(p) || /linux/i.test(ua) ? 'linux' : 'win';
          document.documentElement.dataset.os = os;
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
