---
// The download page, built from src/data/release.json (refresh it with
// `bun run site:release`). The visitor's platform decides the primary button
// (see DownloadButton); every other asset is listed below it with its size
// and SHA-256 when the release publishes one.
import Layout from '~/layouts/Layout.astro';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import PageHeading from '~/components/PageHeading.astro';
import DownloadButton from '~/components/DownloadButton.astro';
import Capture from '~/components/ui/Capture.astro';
import { whatsNewPosts } from '~/data/changelog';
import {
  OS_NAME,
  type Os,
  formatDate,
  formatSize,
  installers,
  latestRelease,
} from '~/data/site';

const oses: Os[] = ['win', 'mac', 'linux'];
const missing = oses.filter((os) => !installers.some((i) => i.os === os));
const notesHref = whatsNewPosts[latestRelease.version] ?? `/changelog#v${latestRelease.version}`;
---

<Layout
  title="Download BorgDock"
  description={`Download BorgDock ${latestRelease.version}. Install it once and it keeps itself up to date.`}
>
  <SiteNav current="download" />
  <main id="main" class="download">
    <PageHeading
      eyebrow={`Version ${latestRelease.version}, released ${formatDate(latestRelease.date)}`}
      title="Download BorgDock"
      lede="Install it once and BorgDock keeps itself up to date."
      align="center"
    >
      <div class="download__primary">
        <DownloadButton />
        <p class="download__notes">
          <a class="link" href={notesHref}>What's new in {latestRelease.version}</a>
          <span aria-hidden="true">·</span>
          <a class="link" href={latestRelease.url}>Release on GitHub</a>
        </p>
        {
          missing.length > 0 && (
            <p class="download__platforms" data-missing={missing.join(' ')}>
              BorgDock is built for {installers.length > 0 ? [...new Set(installers.map((i) => OS_NAME[i.os]))].join(' and ') : 'no platform'} today.
              There is no {missing.map((os) => OS_NAME[os]).join(' or ')} build yet.
            </p>
          )
        }
      </div>
    </PageHeading>

    <section class="assets" aria-labelledby="assets-title">
      <h2 id="assets-title" class="assets__title">All files in this release</h2>
      <ul class="assets__list">
        {
          installers.map((i) => (
            <li class="asset" data-os={i.os}>
              <div class="asset__main">
                <span class="asset__os">{OS_NAME[i.os]}</span>
                <span class="asset__kind">{i.kind}</span>
                <a class="asset__name" href={i.url}>
                  {i.name}
                </a>
                <span class="asset__size">{formatSize(i.size)}</span>
              </div>
              {i.sha256 && (
                <p class="asset__sum">
                  <span>SHA-256</span>
                  <code>{i.sha256}</code>
                </p>
              )}
            </li>
          ))
        }
      </ul>
      <p class="assets__foot">
        Check a download on Windows with <code>Get-FileHash &lt;file&gt;</code> in PowerShell, or
        <code>shasum -a 256 &lt;file&gt;</code> elsewhere, and compare it with the line above. Older
        versions are on the <a class="link" href={`https://github.com/${latestRelease.repo}/releases`}>releases page</a>.
      </p>
    </section>

    <section class="download__after" aria-labelledby="after-title">
      <h2 id="after-title" class="assets__title">After you install</h2>
      <p>
        The setup wizard connects BorgDock to GitHub and helps you pick the repositories to watch.
        Your pull requests show up in the Pull requests section right after.
      </p>
      <Capture slug="workbench-list" />
    </section>
  </main>
  <SiteFooter />
</Layout>
