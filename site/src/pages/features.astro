---
import Layout from '~/layouts/Layout.astro';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import PageHeading from '~/components/PageHeading.astro';
import Job from '~/components/sections/Job.astro';
import DownloadBlock from '~/components/sections/DownloadBlock.astro';
import Capture from '~/components/ui/Capture.astro';
import Recording from '~/components/ui/Recording.astro';

const toc = [
  { id: 'watch', label: 'Pull requests' },
  { id: 'failures', label: 'Shared failures' },
  { id: 'decide', label: 'Focus' },
  { id: 'activity', label: 'Activity' },
  { id: 'review', label: 'Quick review' },
  { id: 'dispatch', label: 'Dispatch' },
  { id: 'workstreams', label: 'Workstreams' },
  { id: 'notes', label: 'Notes' },
  { id: 'fix', label: 'Fix with Claude' },
  { id: 'work', label: 'Worktrees and Work items' },
  { id: 'tools', label: 'Tools' },
];

const tools = [
  {
    slug: 'work-items',
    name: 'Work items',
    text: 'Your Azure DevOps queries in the same window, grouped by state. Open an item full screen and change it without a browser.',
  },
  {
    slug: 'worktrees-window',
    name: 'Worktrees window',
    text: 'Press Ctrl+F7 from anywhere for every worktree in a small window. Enter opens a terminal in the one you picked.',
  },
  {
    slug: 'notes-quick',
    name: 'Quick note',
    text: "Press Ctrl+F8 in any app and type. The note lands in today's note, linked to the pull request or work item you last had open.",
  },
  {
    slug: 'sql',
    name: 'SQL',
    text: 'Press Ctrl+F10, write a query and read the results in a grid you can copy straight from.',
  },
  {
    slug: 'open-in-t3',
    name: 'Open in T3',
    text: "Pick the machine, and T3 checks out the pull request's branch, reusing the worktree that already has it. Works from the list, the detail window and the tray.",
  },
  {
    slug: 'settings-agents',
    name: 'Settings',
    text: 'Pair with T3 Code in one click, add your other machines and edit the prompts Dispatch starts agents with, under Settings → Agents.',
  },
];
---

<Layout
  title="GitHub PR reviews, CI monitoring and Azure DevOps | BorgDock"
  description="What BorgDock does for you: watch your pull requests and the failures they share, decide what needs you, review and merge, walk your work items with the agents on them, keep goals and notes next to the work, and hand failures to an agent."
>
  <SiteNav current="features" />
  <main id="main">
    <PageHeading
      eyebrow="Features"
      title="Everything around a pull request, one window."
      lede="BorgDock does the parts of pull request and agent work that usually cost you a browser tab: checks, reviews, work items, notes and the agents on them."
    >
      <nav class="toc" aria-label="On this page">
        {toc.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
      </nav>
    </PageHeading>

    <div class="jobs">
      <Job id="watch" eyebrow="Pull requests" title="Watch every pull request" reading>
        <p>
          The Pull requests section lists every open pull request across your repositories, with one
          row each and the checks drawn as a single bar.
        </p>
        <p>
          Filter to Needs you, Mine or Failing, or group by repository or author, and the rows slide
          to their new place. Hide failing leaves out every pull request with a failing check, so what
          is left is green or still running.
        </p>
        <p>
          Click a row and the pull request opens full screen in the same window, with its whole
          description and screenshots. Back or Esc takes you straight back to where you were.
        </p>
        <Recording slot="media" slug="pr-detail-push" />
      </Job>

      <Job id="failures" eyebrow="Shared failures" title="Fix a broken test once, not on every pull request" reverse reading>
        <p>
          When the same CI failure breaks several pull requests, it gets one row above the list: the
          failing test, how many pull requests it blocks and who is on it. A pull request that is red
          only because of master, a flaky test or the runners says Not caused by this PR.
        </p>
        <p>
          Failing on master too? BorgDock compares the last passing run with the first failing one and
          names the pull request merged in between, so you can ask its author or open a revert.
        </p>
        <p>
          Investigate hands one agent the evidence from every affected pull request. Once the fix is on
          master, Update affected merges master into each of them, so their checks run again.
        </p>
        <Capture slot="media" slug="ci-shared" />
      </Job>

      <Job id="decide" eyebrow="Focus" title="Decide what needs you" reading>
        <p>
          Focus shows only the pull requests that need something from you, and says why: a review
          request, a failing check, a conflict.
        </p>
        <p>
          An agent with a question, a plan to approve or a failure sits at the top, with the obvious
          action on it, so you never leave one waiting.
        </p>
        <p>
          Switch to the board to see Needs you, Waiting on others, Ready to merge and Stale side by
          side, and merge a green pull request right from it.
        </p>
        <Recording slot="media" slug="focus-merge" />
      </Job>

      <Job id="activity" eyebrow="Activity" title="Catch up on what changed while you were away" reverse reading>
        <p>
          Activity lists what happened since you last looked: questions from your agents, plans waiting
          for your approval, failed checks, new reviews and your merged work reaching an environment.
        </p>
        <p>
          What needs you comes first, and every row has the action that fits. Focus opens with a Since
          you last checked card, and the tray icon shows how much is waiting.
        </p>
        <Capture slot="media" slug="activity" />
      </Job>

      <Job id="review" eyebrow="Quick review" title="Review file by file, decide on the last one" reading>
        <p>
          Press Start Quick Review in Focus and every pull request that waits for your review lines up.
          The pull request stays above the diff, with its labels, CI and work item, and its proof sits
          in a panel beside the code.
        </p>
        <p>
          Press V to mark a file reviewed and open the next. On the last file the footer becomes your
          decision, and the next pull request opens as soon as you make it. Approvals wait five seconds,
          so you can still undo one.
        </p>
        <p>Back at a pull request you reviewed before? You see only the files that changed since.</p>
        <p><a class="link" href="/quick-review">Everything Quick review does</a></p>
        <Recording slot="media" slug="quick-review-walk" />
      </Job>

      <Job id="dispatch" eyebrow="Dispatch" title="Walk your work every morning" reverse reading>
        <p>
          Dispatch puts every Azure DevOps item assigned to you next to the T3 Code threads and the
          pull request that belong to it. It opens on a briefing: how many items need you, are out of
          sync, are worth a look, have an agent working or are fine.
        </p>
        <p>
          Click a number to see only those items. Below it, every state gets a section in the order
          you check them, and each item says what it needs and why.
        </p>
        <p>
          A pull request merged while the item still says Code Review? Dispatch marks it Out of sync,
          and Fix out of sync hands them all to one agent that makes the moves the way your
          repository's skills ask.
        </p>
        <Recording slot="media" slug="dispatch-briefing" />
      </Job>

      <Job id="agents" eyebrow="Dispatch" title="Start and answer your agents" reading>
        <p>
          Start in T3 asks where the agent works: the machine T3 runs on, the repository and the branch
          to start from. T3 makes a fresh worktree for the thread, so there is nothing to keep free.
        </p>
        <p>
          Or pick Existing thread to continue one that already worked on the item. Handing an item to
          QA goes back to the agent that knows what it changed.
        </p>
        <p>
          When an agent asks a question you see its options next to the item. A plan gets Approve
          plan, and Open in T3 is one key away when you want the whole conversation.
        </p>
        <p><a class="link" href="/dispatch">Everything Dispatch does</a></p>
        <Recording slot="media" slug="dispatch-start" />
      </Job>

      <Job id="workstreams" eyebrow="Workstreams" title="Keep a goal together across items, threads and pull requests" reverse reading>
        <p>
          Some goals take several work items, a couple of agent threads and a handful of pull requests.
          A workstream keeps them under one goal, with the outcomes it needs and a next action you set.
        </p>
        <p>
          BorgDock checks each outcome against the real records. When the pull request merges or the
          item reaches Done, the outcome turns green, and you hear about it if the item is reopened.
        </p>
        <p>
          Review with agent sends everything to a T3 thread, which comes back with proposals you accept
          or reject. Point Settings → Workstreams at a synced folder and your other machine sees the
          same workstreams.
        </p>
        <Capture slot="media" slug="workstreams" />
      </Job>

      <Job id="notes" eyebrow="Notes" title="Write it down where your work is" reading>
        <p>
          Notes are Markdown files in a folder that Obsidian and VS Code open as they are. Link them
          with [[Title]] and see every note that links back.
        </p>
        <p>
          Type AB#60102 or shop#3712 and it becomes a chip with the item's state or the pull request's
          checks. Pull requests, work items and workstreams get a Notes tab with every note that
          mentions them.
        </p>
        <p>
          Today starts the day's note with what happened since yesterday. Start a T3 thread from a note
          and the agent's answer lands in it when it stops.
        </p>
        <Capture slot="media" slug="notes" />
      </Job>

      <Job id="fix" eyebrow="Fix with Claude" title="Hand a failure to an agent" reverse reading>
        <p>
          When a check fails, the pull request shows the first error from its log, so you see what
          broke without scrolling.
        </p>
        <p>
          Fix with Claude starts Claude Code on that branch with the error as its prompt, in its own
          worktree, so your checkout stays as it is. If someone already owns that failure, BorgDock
          offers their thread first.
        </p>
        <p>
          Prefer T3 Code? Open in T3 starts a thread linked to the pull request, on whichever machine
          you pick.
        </p>
        <Capture slot="media" slug="pr-detail-failing" />
      </Job>

      <Job id="work" eyebrow="Worktrees and Work items" title="Keep the rest of your work close" reading>
        <p>
          Worktrees groups your worktrees by the machine they live on, under that machine's free disk
          space. A disk that runs low stands out, with Clean up in T3 right beside it.
        </p>
        <p>
          Every row shows its branch, its changes and the pull request on it. Press O for a terminal,
          T to open it in T3 or F to make it a favourite.
        </p>
        <p>
          Work items brings your Azure DevOps queries into the same window, so you can open an item
          and change it without a browser.
        </p>
        <Capture slot="media" slug="worktrees" />
      </Job>
    </div>

    <section id="tools" class="also" aria-labelledby="tools-title">
      <h2 id="tools-title" class="also__title">Tools</h2>
      <div class="also__grid">
        {
          tools.map((t) => (
            <figure class="also__item">
              <Capture slug={t.slug} />
              <figcaption>
                <strong class="also__name">{t.name}</strong>
                {t.text}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <DownloadBlock />
  </main>
  <SiteFooter />
</Layout>
