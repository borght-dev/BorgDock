---
import ReleaseCapture from '~/components/ui/ReleaseCapture.astro';
import { Image } from 'astro:assets';
import { phoneScreens } from '~/data/iphone';
import Layout from '~/layouts/Layout.astro';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import PageHeading from '~/components/PageHeading.astro';
import Job from '~/components/sections/Job.astro';
import DownloadBlock from '~/components/sections/DownloadBlock.astro';
import Capture from '~/components/ui/Capture.astro';
import Recording from '~/components/ui/Recording.astro';

const toc = [
  { id: 'watch', label: 'Pull requests' },
  { id: 'failures', label: 'Shared failures' },
  { id: 'decide', label: 'Focus' },
  { id: 'recent', label: 'Recent' },
  { id: 'review', label: 'Quick review' },
  { id: 'dispatch', label: 'Dispatch' },
  { id: 'notes', label: 'Notes' },
  { id: 'fix', label: 'Fix with Claude' },
  { id: 'work-items', label: 'Work items' },
  { id: 'iphone', label: 'iPhone' },
  { id: 'tools', label: 'Tools' },
];

const tools = [
  {
    slug: 'worktrees-window',
    name: 'Worktrees window',
    text: "Press Ctrl+F7 from anywhere for every worktree in a small window, grouped by the machine it lives on under that machine's free disk space. Enter opens a terminal in the one you picked.",
  },
  {
    slug: 'ai-limits',
    name: 'Limits left',
    text: 'See the weekly and session allowance for each Claude and Codex account, and when it resets. GitHub appears last when its API quota runs low. Focus lists the threads affected by an exhausted account.',
  },
  {
    slug: 'machines',
    name: 'Machines',
    text: 'Free disk space for every machine your agents work on, with the worktrees whose pull request already merged. Prune them or clear the build caches before a disk fills up.',
  },
  {
    slug: 'notes-quick',
    name: 'Quick note',
    text: "Press Ctrl+F8 in any app and type. The note lands in today's note, linked to the pull request or work item you last had open.",
  },
  {
    slug: 'work-item-palette',
    name: 'Work item palette',
    text: 'Press Ctrl+F9 to browse your assigned and recent items or search by ID and title.',
  },
  {
    slug: 'tray-glance',
    name: 'Tray flyout',
    text: 'Open the tray to check review requests and CI while another app is in front.',
  },
  {
    slug: 'settings-iphone',
    name: 'Link your iPhone',
    text: 'Link the desktop to your BorgDock server to share read status with your iPhone and keep phone notifications quiet while you work at your desk.',
  },
  {
    slug: 'sql',
    name: 'SQL',
    text: 'Press Ctrl+F10 to query SQL Server. Run a selection with Ctrl+Enter, save snippets and copy results with their column headings.',
  },
  {
    slug: 'open-in-t3',
    name: 'Open in T3',
    text: "Pick the machine, and T3 checks out the pull request's branch, reusing the worktree that already has it. Works from the list, the detail window and the tray.",
  },
  {
    slug: 'settings-agents',
    name: 'Settings',
    text: 'Pair with T3 Code in one click, add your other machines and edit the prompts Dispatch starts agents with, under Settings → Agents.',
  },
];
---

<Layout
  title="GitHub PR reviews, CI monitoring and Azure DevOps | BorgDock"
  description="See how BorgDock handles GitHub reviews, shared CI failures, Azure DevOps work items, T3 agents and Markdown notes. Explore the desktop tools and iPhone apps."
>
  <SiteNav current="features" />
  <main id="main">
    <PageHeading
      eyebrow="Features"
      title="Everything around a pull request, one window."
      lede="BorgDock does the parts of pull request and agent work that usually cost you a browser tab: checks, reviews, work items, notes and the agents on them."
    >
      <nav class="toc" aria-label="On this page">
        {toc.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
      </nav>
    </PageHeading>

    <div class="jobs">
      <Job id="watch" eyebrow="Pull requests" title="Watch every pull request" reading>
        <p>
          The Pull requests section lists every open pull request across your repositories, with one
          row each and the checks drawn as a single bar.
        </p>
        <p>
          Pick a tab (Your turn, Mine, Failing, Ready to merge, Stale) or type
          <code>author:vera is:failing</code> into the search, group by status, author, repository or
          who has to act next, and the rows slide to their new place. Every row says what has to
          happen next and whose move it is. Save a setup you like as a view of its own, or switch to
          a board with a column per status.
        </p>
        <p>
          Click a row and the pull request opens full screen in the same window, with its whole
          description and screenshots. Back or Esc takes you straight back to where you were.
        </p>
        <p>Batch-approve dependency updates from the list. Patch and minor updates with healthy checks start selected. Display can keep PRs visible when only unrelated checks failed.</p>
        <ReleaseCapture slot="media" path="4.11.0/filters-views.png" alt="Filter chips and saved views above the pull request table" />
      </Job>

      <Job id="failures" eyebrow="Shared failures" title="Find the cause of a shared CI failure" reverse reading>
        <p>
          When the same CI failure breaks several pull requests, it gets one row above the list: the
          failing test, how many pull requests it blocks and who is on it. A pull request that is red
          only because of master, a flaky test or the runners says Not caused by this PR.
        </p>
        <p>
          Failing on master too? BorgDock compares the last passing run with the first failing one and
          names the pull request merged in between, so you can ask its author or open a revert.
        </p>
        <p>
          Investigate hands one agent the evidence from every affected pull request. Once the fix is on
          master, Update affected merges master into each of them, so their checks run again.
        </p>
        <Capture slot="media" slug="ci-shared" />
      </Job>

      <Job id="decide" eyebrow="Focus" title="Decide what needs you" reading>
        <p>
          Focus shows only the pull requests that need something from you, and says why: a review
          request, a failing check, a conflict.
        </p>
        <p>
          An agent with a question, a plan to approve or a failure sits at the top, with the obvious
          action on it, so you never leave one waiting.
        </p>
        <p>
          Switch to the board to see Needs you, Waiting on others, Ready to merge and Stale side by
          side, and merge a green pull request right from it.
        </p>
        <Recording slot="media" slug="focus-merge" />
      </Job>

      <Job id="recent" eyebrow="Recent" title="Catch up on what changed while you were away" reverse reading>
        <p>
          The bell in the corner of the rail counts what still needs you: a question from an agent, a
          plan waiting for your approval, a failed check on your pull request, a review request.
        </p>
        <p>
          Click it for Recent. What needs you comes first, each with the action that fits, followed by
          what happened since you last looked: merges, deployments, new reviews. Something stops
          counting the moment it is handled, wherever you handled it.
        </p>
        <p>All history opens the full list in a window of its own. Turn on review reminders in Settings to get a Start Review action when a request has been waiting.</p>
        <Capture slot="media" slug="recent" />
      </Job>

      <Job id="review" eyebrow="Quick review" title="Read the files that need your review" reading>
        <p>
          Press Start Quick Review in Focus and every pull request that waits for your review lines up.
          The pull request stays above the diff, with its labels, CI and work item, and its proof sits
          in a panel beside the code.
        </p>
        <p>
          Press V to mark a file reviewed and open the next. You can comment or approve while files
          are still unread. Settings can require a complete file review before approval. Approvals wait five seconds,
          so you can still undo one.
        </p>
        <p>Back at a pull request you reviewed before? You see only the files that changed since.</p>
        <p><a class="link" href="/quick-review">Everything Quick review does</a></p>
        <Recording slot="media" slug="quick-review-walk" />
      </Job>

      <Job id="dispatch" eyebrow="Dispatch" title="Walk your work every morning" reverse reading>
        <p>
          Dispatch puts every Azure DevOps item assigned to you next to the T3 Code threads and the
          pull request that belong to it. It opens on a briefing: how many items need you, are out of
          sync, are worth a look, have an agent working or are fine.
        </p>
        <p>
          Click a number to see only those items. Below it, every state gets a section in the order
          you check them, and each item says what it needs and why.
        </p>
        <p>
          A pull request merged while the item still says Code Review? Dispatch marks it Out of sync,
          and Fix out of sync hands them all to one agent that makes the moves the way your
          repository's skills ask.
        </p>
        <Recording slot="media" slug="dispatch-briefing" />
      </Job>

      <Job id="agents" eyebrow="Dispatch" title="Start and answer your agents" reading>
        <p>
          Start in T3 asks where the agent works: the machine T3 runs on, the repository and the branch
          to start from. T3 makes a fresh worktree for the thread, so there is nothing to keep free.
        </p>
        <p>
          Or pick Existing thread to continue one that already worked on the item. Handing an item to
          QA goes back to the agent that knows what it changed.
        </p>
        <p>
          When an agent asks a question you see its options next to the item. A plan gets Approve
          plan, and Open in T3 is one key away when you want the whole conversation.
        </p>
        <p><a class="link" href="/dispatch">Everything Dispatch does</a></p>
        <Recording slot="media" slug="dispatch-start" />
      </Job>

      <Job id="work-items" eyebrow="Work items" title="Read the item behind the pull request" reading>
        <p>Open an AB# link for a peek, or open the full item to change its state, assignment, priority or iteration. Now shows the linked pull request, checks and agent. Latest shows the newest update.</p>
        <p>The Activity timeline puts field changes beside comments and linked pull requests. Expand an agent run to see each step.</p>
        <ReleaseCapture slot="media" path="4.12.0/work-item-detail.png" alt="Azure DevOps work item with editable fields, Now and Latest" />
      </Job>

      <Job id="notes" eyebrow="Notes" title="Write it down where your work is" reverse reading>
        <p>
          Notes are Markdown files in a folder that Obsidian and VS Code open as they are. Link them
          with [[Title]] and see every note that links back.
        </p>
        <p>
          Type AB#60102 or shop#3712 and it becomes a chip with the item's state or the pull request's
          checks. Pull requests and work items get a Notes tab with every note that mentions them.
        </p>
        <p>
          Choose a folder for your daily notes in Settings. Create folders, rename them or move notes between them in the vault. Start a T3 thread from a note
          and the agent's answer lands in it when it stops. Point Settings → Notes at a folder your sync
          client shares and your other machine has the same notes.
        </p>
        <ReleaseCapture slot="media" path="4.15.0/notes-vault-controls.png" alt="Notes vault with daily notes and folder controls" />
      </Job>

      <Job id="fix" eyebrow="Fix with Claude" title="Hand a failure to an agent" reading>
        <p>
          When a check fails, the pull request shows the first error from its log, so you see what
          broke without scrolling.
        </p>
        <p>
          Fix with Claude starts Claude Code on that branch with the error as its prompt, in its own
          worktree, so your checkout stays as it is. If someone already owns that failure, BorgDock
          offers their thread first.
        </p>
        <p>
          Prefer T3 Code? Open in T3 starts a thread linked to the pull request, on whichever machine
          you pick.
        </p>
        <Capture slot="media" slug="pr-detail-failing" />
      </Job>
      <Job id="iphone" eyebrow="iPhone" title="Review from your phone" reverse>
        <p>BorgDock Review connects directly to your GitHub accounts. Find a pull request in a saved view, read the diff and send a review. Connect Azure DevOps to open the linked work item.</p>
        <p><a class="link" href="/iphone">Explore the iPhone screens</a></p>
        <Image slot="media" class="phone-preview" src={phoneScreens['pull-requests-home'].image} alt="Pull requests grouped by status in BorgDock Review on iPhone" width={480} format="webp" loading="lazy" />
      </Job>
    </div>

    <section id="tools" class="also" aria-labelledby="tools-title">
      <h2 id="tools-title" class="also__title">Tools</h2>
      <div class="also__grid">
        {
          tools.map((t) => (
            <figure class="also__item">
              <Capture slug={t.slug} />
              <figcaption>
                <strong class="also__name">{t.name}</strong>
                {t.text}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <DownloadBlock />
  </main>
  <SiteFooter />
</Layout>
