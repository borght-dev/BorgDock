---
// Every capture in both themes, and every recording, filterable by page and
// theme. A tile opens in a <dialog> lightbox. Tiles are plain server-rendered
// buttons; the script only toggles `hidden` and fills the dialog.
import Layout from '~/layouts/Layout.astro';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import PageHeading from '~/components/PageHeading.astro';
import { GALLERY_PAGES, captures, recordings, type Theme } from '~/data/media';

interface Tile {
  key: string;
  page: string;
  theme: Theme;
  alt: string;
  thumb: { src: string; width: number; height: number; density: number };
  video?: string;
}

const tiles: Tile[] = [];
for (const c of captures.filter((x) => !x.draft)) {
  for (const theme of ['light', 'dark'] as const) {
    const img = c.images[theme];
    if (img) {
      tiles.push({ key: `${c.slug}-${theme}`, page: c.page, theme, alt: c.alt, thumb: { ...img, density: 2 } });
    }
  }
}
for (const r of recordings.filter((x) => !x.draft)) {
  for (const theme of ['light', 'dark'] as const) {
    const v = r.variants[theme];
    const video = v?.mp4 ?? v?.webm;
    if (v?.poster && video) {
      tiles.push({
        key: `rec-${r.slug}-${theme}`,
        page: r.page,
        theme,
        alt: r.alt,
        thumb: { ...v.poster, density: 1 },
        video,
      });
    }
  }
}
const pagesWithTiles = GALLERY_PAGES.filter((p) => tiles.some((t) => t.page === p));
---

<Layout
  title="Gallery: BorgDock"
  description="Every BorgDock screen in light and dark, captured from the app's own components."
>
  <SiteNav current="gallery" />
  <main id="main">
    <PageHeading
      eyebrow="Gallery"
      title="Every screen, both themes."
      lede="Every picture is captured from BorgDock's own screens with sample data. Pick a part of the app or a theme, and open any picture full size."
    />

    <div class="gallery-filters">
      <div class="segmented" role="group" aria-label="Part of the app">
        <button type="button" data-filter-page="all" aria-pressed="true">Everything</button>
        {
          pagesWithTiles.map((p) => (
            <button type="button" data-filter-page={p} aria-pressed="false">
              {p}
            </button>
          ))
        }
      </div>
      <div class="segmented" role="group" aria-label="Theme">
        <button type="button" data-filter-theme="all" aria-pressed="true">Both themes</button>
        <button type="button" data-filter-theme="light" aria-pressed="false">Light</button>
        <button type="button" data-filter-theme="dark" aria-pressed="false">Dark</button>
      </div>
    </div>

    <ul class="gallery" data-gallery>
      {
        tiles.map((t) => (
          <li class="gallery__item" data-page={t.page} data-theme={t.theme}>
            <button
              type="button"
              class="gallery__tile"
              data-full={t.thumb.src}
              data-video={t.video}
              data-alt={t.alt}
              aria-label={`Open full size: ${t.alt} (${t.theme} theme${t.video ? ', recording' : ''})`}
            >
              <img
                src={t.thumb.src}
                srcset={t.thumb.density === 2 ? `${t.thumb.src} 2x` : undefined}
                width={t.thumb.width}
                height={t.thumb.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="gallery__label">
                <span>{t.page}</span>
                <span class="gallery__tags">
                  {t.video && <span class="tag">Recording</span>}
                  <span class="tag">{t.theme === 'dark' ? 'Dark' : 'Light'}</span>
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    <p class="gallery-empty" data-gallery-empty hidden>Nothing matches these filters.</p>

    <dialog class="lightbox" data-lightbox aria-label="Full size picture">
      <form method="dialog" class="lightbox__bar">
        <p class="lightbox__caption" data-lightbox-caption></p>
        <button class="btn btn--quiet btn--sm" value="close">Close</button>
      </form>
      <div class="lightbox__body" data-lightbox-body></div>
    </dialog>
  </main>
  <SiteFooter />
</Layout>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('[data-gallery] .gallery__item')];
  const empty = document.querySelector<HTMLElement>('[data-gallery-empty]');
  const state = { page: 'all', theme: 'all' };

  function apply() {
    let shown = 0;
    for (const li of items) {
      const ok =
        (state.page === 'all' || li.dataset.page === state.page) &&
        (state.theme === 'all' || li.dataset.theme === state.theme);
      li.hidden = !ok;
      if (ok) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  }

  function wire(attr: 'page' | 'theme') {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(`[data-filter-${attr}]`)];
    for (const b of buttons) {
      b.addEventListener('click', () => {
        state[attr] = b.getAttribute(`data-filter-${attr}`) ?? 'all';
        for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
        apply();
      });
    }
  }
  wire('page');
  wire('theme');

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const body = document.querySelector<HTMLElement>('[data-lightbox-body]');
  const caption = document.querySelector<HTMLElement>('[data-lightbox-caption]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const tile of document.querySelectorAll<HTMLButtonElement>('.gallery__tile')) {
    tile.addEventListener('click', () => {
      if (!dialog || !body || !caption) return;
      const alt = tile.dataset.alt ?? '';
      const full = tile.dataset.full ?? '';
      body.replaceChildren();
      if (tile.dataset.video && !reduce.matches) {
        const v = document.createElement('video');
        v.src = tile.dataset.video;
        v.poster = full;
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.controls = true;
        v.autoplay = true;
        v.setAttribute('aria-label', alt);
        body.append(v);
      } else {
        const img = document.createElement('img');
        img.src = full;
        img.alt = alt;
        body.append(img);
      }
      caption.textContent = alt;
      dialog.showModal();
    });
  }
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => body?.replaceChildren());
</script>
