---
import Layout from '~/layouts/Layout.astro';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
---

<Layout title="Gallery — BorgDock" description="Every BorgDock screen, captured from Storybook.">
  <SiteNav current="gallery" />

  <section style="max-width: 1320px; margin: 0 auto; padding: 64px 32px 24px;">
    <div
      style="font-size: 11px; font-family: var(--font-code); color: var(--color-text-muted); letter-spacing: 0.04em; margin-bottom: 14px;"
    >
      GALLERY · captured from Storybook
    </div>
    <h1
      class="prdock-display"
      style="font-size: clamp(44px, 5vw, 64px); line-height: 1.02; margin: 0; letter-spacing: -0.025em; max-width: 900px;"
    >
      One design vocabulary. <em style="color: var(--color-text-tertiary); font-style: normal; font-weight: 400;">Twelve surfaces.</em>
    </h1>
    <p style="font-size: 15px; color: var(--color-text-secondary); max-width: 640px; margin-top: 16px; line-height: 1.6;">
      The same titlebar, the same pill system, the same keyboard footer, the same
      monospace metadata — across PRs, diffs, checks, files, queries, and settings.
      Every shot is a Playwright capture of the real production component running
      inside Storybook with mock data, regenerated from <code>bun run capture-screenshots</code>.
    </p>
  </section>

  <section class="gallery-grid">
    <article>
      <p class="gallery-caption">Focus · Ctrl+Super+Shift+B</p>
      <h2 class="gallery-title">Triage, <em>ranked.</em></h2>
      <p class="gallery-lede">
        The flyout overlay — quick-glance PR queue from anywhere via the global hotkey.
      </p>
      <div class="gallery-shelf">
        <img src="/screenshots/flyout.png" alt="Flyout overlay" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Main window · PRs</p>
      <h2 class="gallery-title">Grouped by <em>what needs you,</em> not by date.</h2>
      <p class="gallery-lede">
        Section tabs in the titlebar, filter pills underneath, cards grouped by repo.
        The active filter, the count, and the first PR you should review — all above the fold.
      </p>
      <div class="gallery-shelf">
        <img src="/screenshots/main-prs.png" alt="Main window — PRs section" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">PR detail</p>
      <h2 class="gallery-title">Every check, <em>one merge-readiness checklist.</em></h2>
      <p class="gallery-lede">
        Tabs for overview, files, checks, commits, discussion. Merge-readiness checklist on top —
        approval, conflicts, draft, checks — with a hard score so you know if it's actually mergeable.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/screenshots/pr-detail.png" alt="PR detail panel" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">File viewer</p>
      <h2 class="gallery-title">Tree-sitter syntax, <em>vs HEAD or vs base.</em></h2>
      <p class="gallery-lede">
        File tree on the left, syntax-highlighted source on the right, optional diff overlay
        comparing against your local HEAD or the PR's base branch.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/screenshots/file-viewer.png" alt="File viewer" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Settings</p>
      <h2 class="gallery-title">Configure once, <em>configure everything.</em></h2>
      <p class="gallery-lede">
        GitHub auth, Azure DevOps, AI integration, appearance, notifications, maintenance —
        every knob the app exposes, in one window with a single sidebar.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/screenshots/settings.png" alt="Settings window" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Agent overview</p>
      <h2 class="gallery-title">Live status of <em>every Claude Code session.</em></h2>
      <p class="gallery-lede">
        Each running agent across worktrees shows progress, last message, idle / waiting / failed status —
        glanceable so you can hop back to whichever one needs your attention.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/screenshots/agent-overview.png" alt="Agent overview window" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Worktree palette · Ctrl+F7</p>
      <h2 class="gallery-title">Every branch, <em>one palette.</em></h2>
      <p class="gallery-lede">
        Grouped by repo, sorted main → favorites → the rest. Terminal / folder /
        editor actions inline on every row.
      </p>
      <div class="gallery-shelf">
        <img src="/screenshots/worktree-palette.png" alt="Worktree palette" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">File palette · Ctrl+F8</p>
      <h2 class="gallery-title">Every file, <em>every repo.</em></h2>
      <p class="gallery-lede">
        Fuzzy match across every clone in ~/src. Syntax-highlighted preview. Jump to the
        PR that touched the file last.
      </p>
      <div class="gallery-shelf">
        <img src="/screenshots/file-palette.png" alt="File palette" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">SQL · Ctrl+F10</p>
      <h2 class="gallery-title">SQL <em>where you already are.</em></h2>
      <p class="gallery-lede">
        SQL Server, schema browse, results pane. Read-only by default, syntax matching the
        rest of the app, ⌘-Enter to run.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/screenshots/sql.png" alt="SQL window" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Work item detail</p>
      <h2 class="gallery-title">Azure DevOps work items, <em>in the dock.</em></h2>
      <p class="gallery-lede">
        State, assignee, sprint, comments, linked PRs — all on one card, no browser tab needed.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/screenshots/work-item-detail.png" alt="Work item detail" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Work item palette</p>
      <h2 class="gallery-title">Browse, search, mine — <em>three sections, one keystroke.</em></h2>
      <p class="gallery-lede">
        Browse work items by query, search by title or ID, or filter to ones assigned to you —
        all from a single palette.
      </p>
      <div class="gallery-shelf">
        <img src="/screenshots/work-item-palette.png" alt="Work item palette" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">What's new</p>
      <h2 class="gallery-title">Release notes <em>where the app already is.</em></h2>
      <p class="gallery-lede">
        Per-version changelog with hero banners. Auto-opens once after every update.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/screenshots/whats-new.png" alt="What's new window" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">PR detail · animated</p>
      <h2 class="gallery-title">Tab carousel <em>in motion.</em></h2>
      <p class="gallery-lede">
        Overview → Files → Checks → Discussion. Captured by Playwright as the story's
        play function clicks each tab; encoded as a 5.5-second GIF.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/anim/pr-detail-tabs.gif" alt="PR detail tab carousel" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Worktree palette · animated</p>
      <h2 class="gallery-title">Arrow-down, <em>Enter to launch.</em></h2>
      <p class="gallery-lede">
        Navigate rows with the keyboard, land on the target worktree, press Enter —
        the terminal opens. No mouse required.
      </p>
      <div class="gallery-shelf">
        <img src="/anim/worktree-palette-enter.gif" alt="Worktree palette — Enter launches terminal" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Work item palette · animated</p>
      <h2 class="gallery-title">Browse, type, <em>results instantly.</em></h2>
      <p class="gallery-lede">
        Type "auth" to filter by title, clear, type "12" to search by ID prefix —
        the debounced search responds to every keystroke.
      </p>
      <div class="gallery-shelf">
        <img src="/anim/work-item-palette-tour.gif" alt="Work item palette — search tour" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Setup wizard · animated</p>
      <h2 class="gallery-title">Auth, Next, <em>repos discovered.</em></h2>
      <p class="gallery-lede">
        PAT token entered, Next button clicked, local repos auto-discovered —
        the three-step first-run wizard in 5 seconds.
      </p>
      <div class="gallery-shelf">
        <img src="/anim/wizard-stepthrough.gif" alt="Setup wizard — step through Auth to Repos" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Settings · animated</p>
      <h2 class="gallery-title">Sidebar sections, <em>one click each.</em></h2>
      <p class="gallery-lede">
        Appearance, Notifications, Claude Code — three section switches, each
        revealing its content in the main pane without a reload.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/anim/settings-section-switch.gif" alt="Settings — section switch animation" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Focus · Quick Review · animated</p>
      <h2 class="gallery-title">Start Quick Review, <em>overlay opens.</em></h2>
      <p class="gallery-lede">
        One button click on the focus list launches the Quick Review overlay —
        the ranked PR queue rendered on top, ready for keyboard decisions.
      </p>
      <div class="gallery-shelf">
        <img src="/anim/focus-quick-review.gif" alt="Focus — Start Quick Review" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Merge toast · animated</p>
      <h2 class="gallery-title">3-second undo, <em>then merge fires.</em></h2>
      <p class="gallery-lede">
        Queue a merge, watch the countdown toast tick down, auto-merge fires when
        the timer expires — or click Undo to cancel.
      </p>
      <div class="gallery-shelf">
        <img src="/anim/merge-toast-countdown.gif" alt="Merge toast — countdown" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">File palette · animated</p>
      <h2 class="gallery-title">Fuzzy search, <em>live filtering.</em></h2>
      <p class="gallery-lede">
        Type "app", clear, type "config" — each keystroke narrows the list in real
        time across every file in every tracked repo.
      </p>
      <div class="gallery-shelf">
        <img src="/anim/file-palette-search.gif" alt="File palette — fuzzy search" loading="lazy" />
      </div>
    </article>

    <article>
      <p class="gallery-caption">Agent overview · animated</p>
      <h2 class="gallery-title">State transitions, <em>live.</em></h2>
      <p class="gallery-lede">
        Working → awaiting, awaiting → finished, finished → ended — session state
        cards update as the agent-sessions-changed events arrive.
      </p>
      <div class="gallery-shelf gallery-shelf--wide">
        <img src="/anim/agent-overview-states.gif" alt="Agent overview — state progression" loading="lazy" />
      </div>
    </article>
  </section>

  <SiteFooter />
</Layout>

<style>
  .gallery-shelf img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    background: var(--color-surface, #1a1a1a);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.18),
      0 0 0 1px rgba(255, 255, 255, 0.04);
  }
</style>
