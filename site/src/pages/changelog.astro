---
// Built from /CHANGELOG.md, the same file that feeds the in-app What's new
// window. A release links to its long-form post when
// src/pages/whats-new/<version>.astro exists (see whatsNewPosts).
import Layout from '~/layouts/Layout.astro';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import PageHeading from '~/components/PageHeading.astro';
import { KIND_LABEL, type Kind, formatShortDate, releases, whatsNewPosts } from '~/data/changelog';

const latest = releases[0];
const latestPost = latest ? whatsNewPosts[latest.v] : undefined;
const kindOrder: Kind[] = ['new', 'improved', 'fixed'];
---

<Layout
  title="Changelog: BorgDock"
  description="Every change to BorgDock, from the release notes that ship inside the app."
>
  <SiteNav current="changelog" />
  <main id="main" class="changelog">
    <PageHeading
      eyebrow="Changelog"
      title="What changed, release by release."
      lede="The same notes you see in BorgDock's What's new window. New features first, then improvements, then fixes."
    />

    {
      latest && latestPost && (
        <a class="changelog__featured" href={latestPost}>
          <span class="eyebrow">Latest release, {latest.v}</span>
          <span class="changelog__featured-title">Read the full post about BorgDock {latest.v}</span>
        </a>
      )
    }

    <ol class="changelog__list">
      {
        releases.map((r) => (
          <li class="changelog-row" id={`v${r.v}`}>
            <div class="changelog-row__date">
              <a class="changelog-row__version" href={`#v${r.v}`}>
                {r.v}
              </a>
              <span class="changelog-row__when">{formatShortDate(r.date)}</span>
              {whatsNewPosts[r.v] && (
                <a class="link changelog-row__post" href={whatsNewPosts[r.v]}>
                  Read the post
                </a>
              )}
            </div>
            <div class="changelog-row__body">
              {kindOrder
                .filter((kind) => (r.groups[kind]?.length ?? 0) > 0)
                .map((kind) => {
                  const items = r.groups[kind] ?? [];
                  return (
                    <div class="changelog-row__group">
                      <span class={`kind kind--${kind}`}>{KIND_LABEL[kind]}</span>
                      <ul>
                        {items.map((it) => (
                          <li>
                            {it.body ? (
                              <>
                                <strong>{it.title}</strong>. {it.body}
                              </>
                            ) : (
                              it.title
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  );
                })}
            </div>
          </li>
        ))
      }
    </ol>
  </main>
  <SiteFooter />
</Layout>
