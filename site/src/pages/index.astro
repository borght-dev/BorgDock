---
import ReleaseCapture from '~/components/ui/ReleaseCapture.astro';
import { Image } from 'astro:assets';
import { phoneScreens } from '~/data/iphone';
import Layout from '~/layouts/Layout.astro';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import Hero from '~/components/sections/Hero.astro';
import Job from '~/components/sections/Job.astro';
import DownloadBlock from '~/components/sections/DownloadBlock.astro';
import ChangelogTeaser from '~/components/sections/ChangelogTeaser.astro';
import Capture from '~/components/ui/Capture.astro';
import Recording from '~/components/ui/Recording.astro';
---

<Layout title="BorgDock | GitHub pull requests on desktop and iPhone" description="Review GitHub pull requests, investigate CI and track Azure DevOps work with your agents on desktop. Read diffs and send reviews from your iPhone.">
  <SiteNav current="home" />
  <main id="main">
    <Hero>
      <Capture slot="media" slug="main-rail" />
    </Hero>

    <div class="jobs">
      <Job id="watch" eyebrow="Watch" title="See every check at a glance">
        <p>
          Every open pull request gets one row: who opened it, where it stands, and its checks as a
          single bar. Red means something failed, amber means it is still running.
        </p>
        <p>
          Pick Your turn, Mine or Failing and the list rearranges itself in place. Every row says
          what has to happen next and whose move it is. When one failure breaks several pull
          requests, one line on top says so, with who is on it.
        </p>
        <Capture slot="media" slug="workbench-list" />
      </Job>

      <Job id="decide" eyebrow="Decide" title="Know what needs you next" reverse>
        <p>
          Focus picks out the pull requests that are waiting on you and tells you why each one is
          there. Switch to the board to see them in Needs you, Waiting on others, Ready to merge and
          Stale.
        </p>
        <p>
          Been away? The bell in the rail counts what still needs you, and Recent lists what changed
          since you last looked: an agent's question, a failed check, a new review.
        </p>
        <Capture slot="media" slug="focus-board" />
      </Job>

      <Job id="review" eyebrow="Quick review" title="Read the changes and send your review">
        <p>
          Pick a chapter in the Review Guide to open its first diff. Press V to mark the file reviewed
          and move to the next file in the chapter.
        </p>
        <p>
          Follow a risk assessment to its cited lines, leave a comment or approve when you have seen enough.
          On your own pull request, finish the walk with Done.
        </p>
        <p><a class="link" href="/quick-review">See everything Quick review does</a></p>
        <Recording slot="media" slug="review-guide" />
      </Job>

      <Job id="dispatch" eyebrow="Dispatch" title="See your work and the agents on it" reverse>
        <p>
          Dispatch puts your Azure DevOps items next to the T3 Code threads and pull requests that
          belong to them, and opens on a briefing: what needs you, what fell out of sync and what an
          agent is working on.
        </p>
        <p>
          Click a number to see just those items, or start an agent on the next one, in a fresh
          worktree on any machine that runs T3.
        </p>
        <p><a class="link" href="/dispatch">Take the tour of Dispatch</a></p>
        <Recording slot="media" slug="dispatch-briefing" />
      </Job>

      <Job id="notes" eyebrow="Notes" title="Keep your notes next to the work">
        <p>
          Notes are Markdown files that Obsidian and VS Code open as they are. Type AB#60102 or
          shop#3712 and it turns into a chip that shows the item or pull request as it is right now.
        </p>
        <p>
          Open your daily note with Today, or press Ctrl+F8 in any app to jot something down.
          Quick notes save as you type.
        </p>
        <ReleaseCapture slot="media" path="4.14.0/quick-notes.png" alt="A quick note with a table and highlighted code" />
      </Job>
      <Job id="iphone" eyebrow="iPhone" title="Review from your phone" reverse>
        <p>BorgDock Review connects directly to your GitHub accounts. Find a pull request in a saved view, read the diff and send a review. Connect Azure DevOps to open the linked work item.</p>
        <p><a class="link" href="/iphone">Explore the iPhone screens</a></p>
        <Image slot="media" class="phone-preview" src={phoneScreens['pull-requests-home'].image} alt="Pull requests grouped by status in BorgDock Review on iPhone" width={480} format="webp" loading="lazy" />
      </Job>
    </div>

    <DownloadBlock />
    <ChangelogTeaser />
  </main>
  <SiteFooter />
</Layout>
