---
import BorgDockLogo from '~/components/ui/BorgDockLogo.astro';
import ThemeToggle from '~/components/ThemeToggle';
import { REPO_URL, latestRelease } from '~/data/site';

type NavKey = 'home' | 'features' | 'gallery' | 'changelog' | 'download';

interface Props {
  current?: NavKey;
}
const { current = 'home' } = Astro.props;

const links: { key: NavKey; label: string; href: string }[] = [
  { key: 'features', label: 'Features', href: '/features' },
  { key: 'gallery', label: 'Gallery', href: '/gallery' },
  { key: 'changelog', label: 'Changelog', href: '/changelog' },
];
---

<header class="site-nav">
  <nav class="site-nav__inner" aria-label="Main">
    <a href="/" class="site-nav__brand" aria-label="BorgDock home">
      <BorgDockLogo size={22} />
      <span class="site-nav__brand-name">BorgDock</span>
    </a>
    <a href="/changelog" class="site-nav__version" title="What changed in this version">{latestRelease.version}</a>

    <span class="site-nav__spacer"></span>

    <input type="checkbox" id="site-nav-toggle" class="site-nav__toggle" aria-label="Menu" />

    <div class="site-nav__links">
      {
        links.map((l) => (
          <a href={l.href} class="site-nav__link" aria-current={current === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={REPO_URL} class="site-nav__link" rel="noopener noreferrer">GitHub</a>
      <ThemeToggle client:load />
      <a
        href="/download"
        class="btn btn--primary btn--sm"
        aria-current={current === 'download' ? 'page' : undefined}
      >
        Download
      </a>
    </div>
  </nav>
</header>
