---
import { Image } from 'astro:assets';
import releaseImages from 'virtual:release-images';

interface Props { path: string; alt: string }
const { path, alt } = Astro.props;
---
<Image class="release-capture" src={releaseImages[path]} alt={alt} widths={[640, 1280]}
  sizes="(max-width: 720px) 92vw, 54vw" format="webp" loading="lazy" />

<style>
  .release-capture { display: block; width: 100%; height: auto; border-radius: var(--radius-lg); }
</style>
