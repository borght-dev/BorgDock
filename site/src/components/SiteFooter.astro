---
import BorgDockLogo from '~/components/ui/BorgDockLogo.astro';
import { RELEASES_URL, REPO_URL, latestRelease } from '~/data/site';

const columns: { title: string; links: { label: string; href: string }[] }[] = [
  {
    title: 'BorgDock',
    links: [
      { label: 'Features', href: '/features' },
      { label: 'Gallery', href: '/gallery' },
      { label: 'Download', href: '/download' },
      { label: 'Changelog', href: '/changelog' },
    ],
  },
  {
    title: 'On GitHub',
    links: [
      { label: 'Source code', href: REPO_URL },
      { label: 'Releases', href: RELEASES_URL },
      { label: 'Report a problem', href: `${REPO_URL}/issues` },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label="BorgDock home">
        <BorgDockLogo size={20} />
        <span>BorgDock</span>
      </a>
      <p>
        Your pull requests, their checks, your work items and the agents fixing them, in one
        window on the side of your screen.
      </p>
      <p class="site-footer__small">Version {latestRelease.version}. Free and open source under the MIT license.</p>
    </div>
    {
      columns.map((col) => (
        <div class="site-footer__col">
          <h2 class="site-footer__col-title">{col.title}</h2>
          {col.links.map((l) => (
            <a href={l.href} class="site-footer__link">
              {l.label}
            </a>
          ))}
        </div>
      ))
    }
  </div>
</footer>
